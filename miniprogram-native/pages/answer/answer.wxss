/* 答题页 ·「纸卷 v1」（docs/design-spec.md）
   平铺分区 + 发丝线分层；零阴影、零渐变、唯一圆角 16rpx、8rpx 栅格。
   动效仅 transform/opacity，曲线 var(--ease-spec)。 */

page {
  background: var(--paper);
  color: var(--ink-900);
}

.page-wrap.answer {
  padding: 24rpx 32rpx 220rpx; /* 底部留出固定操作区 */
  min-height: 100vh;
  box-sizing: border-box;
}

/* ---------- 顶栏 + 进度 ---------- */
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.topbar-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ink-900);
}
.topbar-right {
  display: flex;
  align-items: center;
}
.topbar-progress {
  font-size: 22rpx;
  color: var(--ink-500);
  font-variant-numeric: tabular-nums;
  margin-right: 16rpx;
}
.mock-timer {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--primary);
  font-variant-numeric: tabular-nums;
  margin-right: 16rpx;
}
.exit-btn {
  font-size: 22rpx;
  color: var(--ink-500);
  padding: 8rpx 20rpx;
  border: 1rpx solid var(--ink-200);
  border-radius: var(--r-spec);
}

.progress-track {
  height: 4rpx;
  background: var(--ink-200);
  border-radius: 2rpx;
  overflow: hidden;
  margin-top: 20rpx;
}
.progress-fill {
  height: 100%;
  background: var(--primary);
  border-radius: 2rpx;
  transition: width 0.4s var(--ease-spec);
}

/* ---------- 题干区（内容主角，s6 呼吸留白） ---------- */
.qzone {
  margin-top: 72rpx;
}
.qmeta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.qmeta {
  font-size: 22rpx;
  color: var(--ink-500);
}
.kp-repractice {
  font-size: 22rpx;
  color: var(--primary);
  padding: 4rpx 8rpx;
}
.stem {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: var(--ink-900);
  line-height: 1.4;
}
.aigc-note {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--ink-400);
}

/* ---------- 选项行（规范 8.2 五态，发丝线分隔，无框） ---------- */
.options {
  margin-top: 48rpx;
}
.option-row {
  display: flex;
  align-items: center;
  padding: 32rpx 0;
  border-bottom: 1rpx solid var(--ink-200);
  transition: background 0.24s var(--ease-spec), transform 0.15s var(--ease-spec);
}
.opt-key {
  width: 52rpx;
  height: 52rpx;
  line-height: 48rpx;
  text-align: center;
  border: 1rpx solid var(--ink-300);
  border-radius: var(--r-spec);
  font-size: 26rpx;
  color: var(--ink-700);
  margin-right: 24rpx;
  flex-shrink: 0;
  box-sizing: border-box;
  transition: all 0.24s var(--ease-spec);
}
.opt-text {
  flex: 1;
  font-size: 30rpx;
  color: var(--ink-700);
  min-width: 0;
  transition: color 0.24s var(--ease-spec);
}

/* 选中（未揭示 / 模考已选） */
.option-row.picked,
.option-row.opt-picked {
  background: var(--ink-50);
}
.opt-picked .opt-key,
.picked .opt-key,
.key-picked {
  background: var(--primary);
  border-color: var(--primary);
  color: #fff;
}
.opt-picked .opt-text,
.picked .opt-text {
  color: var(--ink-900);
  font-weight: 600;
}

/* 正确 */
.opt-correct .opt-key,
.key-correct {
  background: var(--primary);
  border-color: var(--primary);
  color: #fff;
}
.opt-correct .opt-text {
  color: var(--ink-900);
  font-weight: 600;
}

/* 错误（用户选错的项） */
.opt-wrong .opt-key,
.key-wrong {
  border-color: var(--danger-ink);
  color: var(--danger-ink);
  background: transparent;
}
.opt-wrong .opt-text {
  color: var(--ink-900);
}

/* 漏选（正确但未选）：墨蓝虚线提示 */
.opt-missed .opt-key,
.key-missed {
  border-style: dashed;
  border-color: var(--primary);
  color: var(--primary);
  background: transparent;
}
.opt-missed .opt-text {
  color: var(--ink-900);
}

/* 已答后的其余项：弱化 */
.opt-dim,
.key-dim {
  opacity: 0.45;
}

/* 对错标记：CSS 绘制的线性对勾 / 叉（禁 emoji） */
.mark-ok {
  width: 20rpx;
  height: 12rpx;
  border-left: 4rpx solid var(--primary);
  border-bottom: 4rpx solid var(--primary);
  transform: rotate(-45deg);
  margin-left: 16rpx;
  flex-shrink: 0;
}
.mark-wrong {
  position: relative;
  width: 24rpx;
  height: 24rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}
.mark-wrong::before,
.mark-wrong::after {
  content: "";
  position: absolute;
  top: 50%;
  left: 0;
  width: 26rpx;
  height: 4rpx;
  background: var(--danger-ink);
  border-radius: 2rpx;
}
.mark-wrong::before {
  transform: rotate(45deg);
}
.mark-wrong::after {
  transform: rotate(-45deg);
}

/* ---------- 填空 / 简答 ---------- */
.answer-input {
  width: 100%;
  height: 88rpx;
  margin-top: 48rpx;
  padding: 0 24rpx;
  background: var(--ink-100);
  border-radius: var(--r-spec);
  font-size: 30rpx;
  color: var(--ink-900);
  box-sizing: border-box;
}
.answer-area {
  width: 100%;
  min-height: 240rpx;
  margin-top: 48rpx;
  padding: 24rpx;
  background: var(--ink-100);
  border-radius: var(--r-spec);
  font-size: 30rpx;
  color: var(--ink-900);
  box-sizing: border-box;
}
.input-placeholder {
  color: var(--ink-400);
}
.answer-submit {
  margin-top: 24rpx;
}
.answered-note {
  display: block;
  margin-top: 24rpx;
  font-size: 26rpx;
  color: var(--ink-500);
}

/* ---------- 解析（ink-50 底块，唯一允许的"卡"） ---------- */
.explain {
  margin-top: 48rpx;
  padding: 24rpx;
  background: var(--ink-50);
  border-radius: var(--r-spec);
}
.explain-head {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}
.explain-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink-900);
  margin-right: 16rpx;
}
.state {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: var(--r-spec);
}
.state-ok {
  color: var(--primary);
  border: 1rpx solid var(--primary);
}
.state-bad {
  color: var(--danger-ink);
  border: 1rpx solid var(--danger-ink);
}
.explain-text {
  display: block;
  font-size: 26rpx;
  color: var(--ink-700);
  line-height: 1.7;
}
.report {
  display: inline-block;
  margin-top: 16rpx;
  color: var(--ink-500);
  font-size: 22rpx;
}

/* ---------- 按钮体系（规范 8.1） ---------- */
.btn-primary {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: var(--primary);
  color: #ffffff;
  border-radius: var(--r-spec);
  font-size: 30rpx;
  font-weight: 600;
  transition: transform 0.15s var(--ease-spec);
}
.btn-secondary {
  height: 88rpx;
  line-height: 84rpx;
  text-align: center;
  background: transparent;
  color: var(--primary);
  border: 1rpx solid var(--primary);
  border-radius: var(--r-spec);
  font-size: 30rpx;
  box-sizing: border-box;
  transition: transform 0.15s var(--ease-spec);
}

/* ---------- 底部固定操作区 ---------- */
.bottombar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: var(--paper);
  border-top: 1rpx solid var(--ink-200);
  z-index: 10;
}
.bb-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.bb-nav {
  flex: 1;
  height: 80rpx;
  line-height: 76rpx;
  font-size: 26rpx;
}
.partial-note {
  display: block;
  text-align: center;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--ink-500);
}

/* ---------- 答题卡弹层（ink-50 底、无阴影、格子三态） ---------- */
.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(28, 28, 26, 0.4);
  z-index: 20;
}
.sheet-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--ink-50);
  border-radius: var(--r-spec) var(--r-spec) 0 0;
  padding: 32rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
}
.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.sheet-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink-900);
}
.sheet-count {
  font-size: 22rpx;
  color: var(--ink-500);
  font-variant-numeric: tabular-nums;
}
.sheet-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.sheet-cell {
  width: 88rpx;
  height: 88rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: var(--r-spec);
  font-size: 26rpx;
  background: #fffcf8;
  color: var(--ink-500);
  border: 1rpx solid var(--ink-200);
  box-sizing: border-box;
  transition: transform 0.15s var(--ease-spec);
}
.sheet-done {
  background: var(--primary);
  border-color: var(--primary);
  color: #fff;
  font-weight: 600;
}
.sheet-cur {
  border-color: var(--primary);
  color: var(--primary);
  font-weight: 600;
  background: #fffcf8;
}

/* ---------- 出题失败态（平铺错误区） ---------- */
.error-zone {
  margin-top: 72rpx;
  text-align: left;
}
.error-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ink-900);
}
.error-msg {
  display: block;
  margin: 16rpx 0 32rpx;
  font-size: 26rpx;
  color: var(--ink-500);
  word-break: break-all;
}
.error-zone .btn-secondary {
  display: inline-block;
  padding: 0 48rpx;
  margin-bottom: 24rpx;
}
.back-link {
  display: inline-block;
  color: var(--ink-500);
  font-size: 26rpx;
  padding: 12rpx 0;
}

/* ---------- 提交遮罩 ---------- */
.loading-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(28, 28, 26, 0.45);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 30;
}
.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid var(--ink-200);
  border-top-color: var(--ink-900);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
.loading-text {
  color: var(--ink-900);
  font-size: 26rpx;
  margin-top: 20rpx;
}
@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
