<view class="page-wrap answer">
  <!-- 顶栏：标题 + 进度 + 退出（R8 / O-01，「纸卷 v1」平铺化：进度并入顶栏，不再独立卡片） -->
  <view class="topbar">
    <text class="topbar-title">闯关答题</text>
    <view class="topbar-right">
      <text wx:if="{{isMock}}" class="mock-timer">{{remainText}}</text>
      <text wx:else class="topbar-progress">第 {{curIdx + 1}} / {{total}} 题</text>
      <text class="exit-btn" hover-class="press" hover-stay-time="80" bindtap="confirmExit">退出</text>
    </view>
  </view>
  <view class="progress-track">
    <view class="progress-fill" style="width: {{progressPct}}%" />
  </view>

  <!-- 出题失败态：平铺错误区（含重试次按钮） -->
  <view wx:if="{{loadError}}" class="error-zone">
    <text class="error-title">出题失败</text>
    <text class="error-msg">{{loadError}}</text>
    <view class="btn-secondary" hover-class="press" hover-stay-time="80" bindtap="onRetry">重试出题</view>
    <text class="back-link" hover-class="press" hover-stay-time="80" bindtap="goQuest">返回选择模块</text>
  </view>

  <block wx:else>
    <!-- 题干区（s6 呼吸留白）：题干是唯一 D1 主角 -->
    <view wx:if="{{cur}}" class="qzone">
      <view class="qmeta-row">
        <text class="qmeta">{{cur.kp}}{{cur.isMultiple ? " · 多选" : " · 单选"}}</text>
        <text class="kp-repractice" hover-class="press" hover-stay-time="80" bindtap="onRepracticeCurrent">重练此考点</text>
      </view>
      <text class="stem">{{cur.stem}}</text>
      <text wx:if="{{cur.aigc}}" class="aigc-note">AI 生成，仅供参考</text>

      <!-- 选项：发丝线分隔的行列表，无框无卡（规范 8.2 五态） -->
      <view wx:if="{{curKind === 'option'}}" class="options">
        <view
          wx:for="{{curOptions}}"
          wx:key="key"
          class="option-row {{item.cls}}"
          hover-class="press"
          hover-stay-time="80"
          data-key="{{item.key}}"
          bindtap="onPick"
        >
          <view class="opt-key {{item.keyCls}}">{{item.key}}</view>
          <text class="opt-text">{{item.text}}</text>
          <view wx:if="{{item.mark === 'ok'}}" class="mark-ok" />
          <view wx:elif="{{item.mark === 'wrong'}}" class="mark-wrong" />
        </view>
      </view>

      <!-- 填空题 -->
      <block wx:elif="{{curKind === 'blank'}}">
        <input
          class="answer-input"
          placeholder="请输入答案"
          placeholder-class="input-placeholder"
          value="{{draft}}"
          disabled="{{curRevealed}}"
          bindinput="onDraftInput"
        />
        <view
          wx:if="{{!curRevealed}}"
          class="btn-primary answer-submit"
          hover-class="press"
          hover-stay-time="80"
          bindtap="onConfirmAnswer"
        >提交答案</view>
        <text wx:else class="answered-note">你的作答：{{draft}}</text>
      </block>

      <!-- 简答题 -->
      <block wx:elif="{{curKind === 'short'}}">
        <textarea
          class="answer-area"
          placeholder="请简述你的答案"
          placeholder-class="input-placeholder"
          value="{{draft}}"
          disabled="{{curRevealed}}"
          maxlength="500"
          bindinput="onDraftInput"
        />
        <view
          wx:if="{{!curRevealed}}"
          class="btn-primary answer-submit"
          hover-class="press"
          hover-stay-time="80"
          bindtap="onConfirmAnswer"
        >提交作答</view>
        <text wx:else class="answered-note">你的作答：{{draft}}</text>
      </block>

      <!-- 解析（已揭示时）：ink-50 底块 -->
      <view wx:if="{{curRevealed}}" class="explain">
        <view class="explain-head">
          <text class="explain-label">解析</text>
          <text class="state {{curCorrect ? 'state-ok' : 'state-bad'}}">{{curStateText}}</text>
        </view>
        <text class="explain-text">{{cur.explanation}}</text>
        <text class="report" hover-class="press" hover-stay-time="80" bindtap="onReport">题目有误？报错</text>
      </view>
    </view>

    <!-- 底部固定操作区：答题卡 + 翻题 + 交卷 -->
    <view class="bottombar">
      <view class="bb-row">
        <view class="btn-secondary bb-nav" hover-class="press" hover-stay-time="80" bindtap="onToggleSheet">答题卡</view>
        <view wx:if="{{hasPrev}}" class="btn-secondary bb-nav" hover-class="press" hover-stay-time="80" bindtap="onPrev">上一题</view>
        <view wx:if="{{hasNext}}" class="btn-secondary bb-nav" hover-class="press" hover-stay-time="80" bindtap="onNext">下一题</view>
      </view>
      <view wx:if="{{isMock || allAnswered}}" class="btn-primary" hover-class="press" hover-stay-time="80" bindtap="onSubmit">交卷{{isMock ? "" : "并查看复盘"}}</view>
      <block wx:else>
        <view class="btn-primary" hover-class="press" hover-stay-time="80" bindtap="onSubmitPartial">交卷</view>
        <text class="partial-note">还有 {{total - answeredCount}} 题未答，未答的不计入完成数</text>
      </block>
    </view>
  </block>

  <!-- 答题卡弹层（#26，规范 8.1：ink-50 底、无阴影、格子三态） -->
  <view wx:if="{{sheetOpen}}" class="sheet-mask" bindtap="onToggleSheet">
    <view class="sheet-panel" catchtap="noop">
      <view class="sheet-head">
        <text class="sheet-title">答题卡</text>
        <text class="sheet-count">{{answeredCount}} / {{total}} 已答</text>
      </view>
      <view class="sheet-grid">
        <view
          wx:for="{{sheet}}"
          wx:key="i"
          class="sheet-cell sheet-{{item.state}}"
          hover-class="press"
          hover-stay-time="80"
          data-i="{{item.i}}"
          catchtap="goTo"
        >{{item.n}}</view>
      </view>
    </view>
  </view>

  <!-- F-05：提交中全局遮罩 -->
  <view wx:if="{{requesting > 0}}" class="loading-mask">
    <view class="loading-spinner" />
    <text class="loading-text">提交中…</text>
  </view>
</view>
