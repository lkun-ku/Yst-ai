/* 结果页 ·「纸卷 v1」（docs/design-spec.md）
   hero 战绩大数字（无框居中）+ 模块卡分区；公共类 card-mod/btn-main/btn-sub 来自 app.wxss。 */

page {
  background: var(--ink-50);
  color: var(--ink-900);
}

.page-wrap.review {
  padding: 24rpx 32rpx 64rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ---------- 骨架屏 ---------- */
.sk {
  background: var(--ink-100);
  border-radius: var(--r-spec);
  animation: sk-pulse 1.4s var(--ease-spec) infinite;
}
.sk-line {
  height: 40rpx;
  margin-bottom: 24rpx;
}
.sk-block {
  height: 180rpx;
  margin-bottom: 24rpx;
}
@keyframes sk-pulse {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.55;
  }
}

/* ---------- 结果 hero（无框居中，同首页考期区） ---------- */
.hero-zone {
  padding: 24rpx 0 40rpx;
  text-align: center;
}
.hero-label {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--ink-700);
}
.hero-num-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin-top: 8rpx;
}
.hero-num {
  font-size: 140rpx;
  font-weight: 700;
  color: var(--primary);
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}
.hero-unit {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink-900);
  margin-left: 12rpx;
}
.hero-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--ink-500);
}
.hero-aigc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--ink-400);
}

/* ---------- 五维掌握度 ---------- */
.radar-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
}
.radar-name {
  width: 200rpx;
  font-size: 26rpx;
  color: var(--ink-700);
  flex-shrink: 0;
}
.radar-track {
  flex: 1;
  height: 8rpx;
  background: var(--ink-200);
  border-radius: 4rpx;
  overflow: hidden;
}
.radar-fill {
  height: 100%;
  background: var(--primary);
  border-radius: 4rpx;
  transition: width 0.4s var(--ease-spec);
}
.radar-pct {
  width: 88rpx;
  text-align: right;
  font-size: 26rpx;
  color: var(--ink-900);
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
}

/* ---------- 薄弱考点 ---------- */
.weak-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--ink-200);
}
.weak-row:last-of-type {
  border-bottom: none;
}
.weak-name {
  font-size: 30rpx;
  color: var(--ink-900);
}
.weak-retry {
  flex-shrink: 0;
  font-size: 26rpx;
  color: var(--primary);
  padding: 8rpx 28rpx;
  border: 1rpx solid var(--primary);
  border-radius: var(--r-spec);
}

/* ---------- 下一步 / 段落 ---------- */
.next-text {
  font-size: 30rpx;
  color: var(--ink-900);
  line-height: 1.6;
}
.para-text {
  display: block;
  font-size: 26rpx;
  color: var(--ink-700);
  line-height: 1.8;
}
.para-aigc {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--ink-400);
}

/* ---------- 底部双按钮 ---------- */
.btn-row {
  display: flex;
  gap: 24rpx;
  margin-top: 40rpx;
}
.btn-half {
  flex: 1;
}

/* ---------- 空态 ---------- */
.empty-zone {
  padding: 120rpx 0;
  text-align: center;
}
.empty-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink-900);
}
.empty-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--ink-500);
}
