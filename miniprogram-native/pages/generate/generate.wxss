/* ---------- 生成过程时间线（#26 第二批） ---------- */
.tl-card {
  margin-top: 20rpx;
}

/* 动态滚轮：明确的「AI 正在工作」信号（#26 增强） */
.ai-thinking {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}
.ai-spin {
  width: 28rpx;
  height: 28rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  border: 4rpx solid #e6ecfb;
  border-top-color: #3b7cff;
  animation: ai-spin 0.8s linear infinite;
}
.ai-thinking-text {
  font-size: 24rpx;
  color: #8a8f99;
}
@keyframes ai-spin {
  to {
    transform: rotate(360deg);
  }
}

/* 思考句（模型的构思内容）：弱化 + 斜体，与「动作」区分（#26 增强） */
.tl-think .tl-text {
  color: #8a8f99;
  font-style: italic;
}
.tl-head {
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
  display: block;
  margin-bottom: 12rpx;
}
.tl-item {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f2f2f2;
}
.tl-item:last-of-type {
  border-bottom: none;
}
.tl-typing {
  animation: breathe 1.4s ease-in-out infinite;
}
.tl-icon {
  font-size: 26rpx;
  width: 44rpx;
  flex-shrink: 0;
}
.tl-body {
  flex: 1;
}
.tl-text {
  font-size: 25rpx;
  color: #666;
  line-height: 1.6;
}
.tl-cursor {
  color: #3b7cff;
}
@keyframes breathe {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.45;
  }
}

.doc-title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ---------- 环形进度 ---------- */
.ring-card {
  align-items: center;
}
.ring-wrap {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  margin: 0 auto;
}
.ring {
  width: 200rpx;
  height: 200rpx;
}
.ring-text {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ring-num {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--brand-dark);
}
.ring-total {
  font-size: var(--fs-sm);
  color: var(--text-3);
  margin-left: 6rpx;
}
.ring-stage {
  display: block;
  text-align: center;
  margin-top: 16rpx;
}

/* ---------- 模式 ---------- */
.mode-row {
  gap: 20rpx;
}
.mode-item {
  flex: 1;
  padding: 20rpx 16rpx;
  border: 2rpx solid var(--border);
  border-radius: var(--r-md);
  text-align: center;
}
.mode-item.on {
  border-color: var(--brand);
  background: var(--brand-light);
}
.mode-name {
  display: block;
  font-size: var(--fs);
  font-weight: 600;
  color: var(--text-1);
}

/* ---------- 题型配比 ---------- */
.spec-row {
  padding: 16rpx 0;
  border-bottom: 2rpx dashed var(--border);
}
.spec-name {
  font-size: var(--fs);
  font-weight: 600;
  color: var(--text-1);
}
.stepper {
  gap: 12rpx;
}
.step-btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  border: 2rpx solid var(--border);
  border-radius: var(--r-sm);
  font-size: var(--fs);
  color: var(--text-2);
}
.step-num {
  min-width: 56rpx;
  text-align: center;
  font-size: var(--fs);
  font-weight: 600;
  color: var(--text-1);
}
.step-del {
  margin-left: 8rpx;
  font-size: var(--fs-xs);
  color: var(--text-3);
  padding: 10rpx 12rpx;
}
.add-type {
  margin: 20rpx 0 12rpx;
  text-align: center;
  color: var(--brand-dark);
  font-size: var(--fs-sm);
  padding: 16rpx;
  border: 2rpx dashed var(--brand);
  border-radius: var(--r-md);
}

/* ---------- 章节 / 难度 ---------- */
.head-wrap {
  flex-wrap: wrap;
  gap: 16rpx;
}
.head-chip {
  padding: 10rpx 24rpx;
  border: 2rpx solid var(--border);
  border-radius: var(--r-pill);
  font-size: var(--fs-sm);
  color: var(--text-2);
}
.head-chip.on {
  border-color: var(--brand);
  background: var(--brand-light);
  color: var(--brand-dark);
}
.diff-row {
  gap: 16rpx;
}
.diff-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border: 2rpx solid var(--border);
  border-radius: var(--r-pill);
  font-size: var(--fs-sm);
  color: var(--text-2);
}
.diff-item.on {
  border-color: var(--brand);
  background: var(--brand-light);
  color: var(--brand-dark);
  font-weight: 600;
}

.submit-wrap {
  margin: 32rpx 0 8rpx;
}
.submit-tip {
  display: block;
  text-align: center;
  padding: 24rpx 0;
}

/* ---------- 完成 / 失败 ---------- */
.done-card {
  align-items: center;
}
.done-title {
  display: block;
  font-size: var(--fs-lg);
  font-weight: 600;
  color: var(--success);
  text-align: center;
}
.done-card .t-muted {
  display: block;
  text-align: center;
  margin-top: 8rpx;
}
.err-card {
  text-align: center;
}
.err-msg {
  display: block;
  margin: 16rpx 0 24rpx;
  word-break: break-all;
}
