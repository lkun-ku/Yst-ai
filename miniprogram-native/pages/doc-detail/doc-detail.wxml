<view class="page-wrap">
  <view wx:if="{{loading}}" class="card t-muted">加载中…</view>

  <block wx:elif="{{doc}}">
    <view class="card head-card">
      <text class="d-title">{{doc.title}}</text>
      <text class="d-meta">{{doc.char_count}} 字 · {{doc.chunk_count}} 段 · {{doc.file_type}}</text>
      <text wx:if="{{doc.question_count > 0}}" class="d-meta">已生成 {{doc.question_count}} 题</text>
      <view
        wx:if="{{canPreview}}"
        class="btn-main origin-btn"
        hover-class="press"
        hover-stay-time="80"
        bindtap="onOpenOriginal"
      >查看原文件</view>
      <text wx:else class="d-meta">纯文本文档，可按片段展开，也可切到连续全文阅读</text>

      <!-- 视图切换：#27 实测反馈「只能看到切分后的，没法看原文」→ 补一个连续全文视图 -->
      <view class="view-switch">
        <view
          class="vs-item {{view === 'chunks' ? 'on' : ''}}"
          hover-class="press"
          hover-stay-time="80"
          data-v="chunks"
          bindtap="onSwitchView"
        >按片段</view>
        <view
          class="vs-item {{view === 'full' ? 'on' : ''}}"
          hover-class="press"
          hover-stay-time="80"
          data-v="full"
          bindtap="onSwitchView"
        >连续全文</view>
      </view>
    </view>

    <!-- 连续全文：由切片按原文顺序拼接（已消掉滑窗重叠），与「按片段」是同一份数据的两种读法 -->
    <block wx:if="{{view === 'full'}}">
      <view wx:if="{{fullLoading}}" class="card t-muted">正在拼接全文…</view>
      <block wx:elif="{{full}}">
        <view class="card full-note">
          <text>{{fullNote}}</text>
        </view>
        <view class="card">
          <!-- 按块渲染：标题像标题、表格像表格、列表像列表。
               直接把 markdown 丢进一个 <text> 的话，表格会显示成 `| --- |` —— 那正是用户
               说的"看到的是切分后的"（其实不是切片，是**没有被当作文档读**）。 -->
          <block wx:for="{{fullBlocks}}">
            <text
              wx:if="{{item.type === 'h'}}"
              class="md-h md-h{{item.level}}"
              user-select
            >{{item.text}}</text>
            <text wx:elif="{{item.type === 'li'}}" class="md-li" user-select>{{item.ordered ? "· " : "• "}}{{item.text}}</text>
            <text wx:elif="{{item.type === 'code'}}" class="md-code" user-select>{{item.text}}</text>
            <view wx:elif="{{item.type === 'table'}}" class="md-table">
              <view wx:for="{{item.rows}}" wx:for-item="row" wx:for-index="ri" class="md-tr">
                <text wx:for="{{row}}" wx:for-item="cell" wx:for-index="ci" class="md-td" user-select>{{cell}}</text>
              </view>
            </view>
            <text wx:else class="md-p" user-select>{{item.text}}</text>
          </block>
          <view wx:if="{{!fullBlocks.length}}" class="t-muted">（该资料无可展示的文本）</view>
        </view>
      </block>
      <view wx:else class="card t-muted">全文加载失败，可切回「按片段」逐段查看</view>
    </block>

    <block wx:else>
      <block wx:for="{{groups}}" wx:for-item="g" wx:for-index="gi" wx:key="heading">
        <text class="section-title">{{g.heading}}</text>
        <view class="card">
          <view wx:for="{{g.items}}" wx:for-item="c" wx:for-index="ci" wx:key="id" class="chunk">
            <view
              class="chunk-head"
              hover-class="press"
              hover-stay-time="80"
              data-gi="{{gi}}"
              data-ci="{{ci}}"
              data-cid="{{c.id}}"
              bindtap="onToggleChunk"
            >
              <text class="chunk-text">{{c.isOpen ? c.content : c.preview}}</text>
              <text class="chunk-caret">{{c.isOpen ? "▲" : "▼"}}</text>
            </view>
          </view>
        </view>
      </block>

      <view wx:if="{{!groups.length}}" class="card t-muted">该资料暂无内容切片</view>
    </block>
  </block>

  <view wx:else class="card t-muted">资料不存在或已删除</view>
</view>
