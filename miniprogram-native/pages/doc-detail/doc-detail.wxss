
page {
  background: var(--ink-50);
  --brand: #2f5a8f;
  --brand-dark: #2f5a8f;
  --brand-light: #f3efe7;
  --success: #2f5a8f;
  --success-light: #f3efe7;
  --danger: #c25450;
  --danger-light: #f3efe7;
  --warn: #c25450;
  --warn-light: #f3efe7;
  --text-1: #1c1c1a;
  --text-2: #55524a;
  --text-3: #8a8577;
  --border: #e8e2d8;
  --bg: #f3efe7;
  --card: #faf7f2;
  --shadow-card: none;
}

.head-card {
  display: flex;
  flex-direction: column;
}

.d-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #222;
  line-height: 1.5;
  word-break: break-all;
}

.d-meta {
  font-size: 24rpx;
  color: #8a8f99;
  margin-top: 10rpx;
}

.origin-btn {
  margin-top: 20rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 28rpx;
}

.chunk {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f2f2f2;
}

.chunk:last-of-type {
  border-bottom: none;
}

.chunk-head {
  display: flex;
  align-items: flex-start;
}

.chunk-text {
  flex: 1;
  font-size: 25rpx;
  color: #555;
  line-height: 1.7;
  word-break: break-all;
}

.chunk-caret {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 20rpx;
  color: #b0b6c0;
}

/* ---------------- 视图切换：按片段 / 连续全文 ---------------- */

.view-switch {
  display: flex;
  margin-top: var(--sp-sm);
  padding: 4rpx;
  border-radius: var(--r-pill);
  background: var(--bg);
}

.vs-item {
  flex: 1;
  padding: 12rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #6b7280;
  border-radius: var(--r-pill);
}

.vs-item.on {
  background: var(--card);
  color: var(--brand);
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(27, 42, 51, 0.06);
}

/* 全文说明条：用「信息」色而非警示色 —— 这是如实交代，不是出错 */
.full-note {
  background: var(--accent-light);
}

.full-note text {
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--accent);
}

.full-text {
  display: block;
  font-size: 27rpx;
  line-height: 1.8;
  color: #3c4450;
  word-break: break-all;
  white-space: pre-wrap;
}
