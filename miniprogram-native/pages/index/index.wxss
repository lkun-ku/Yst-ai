/* 首页 ·「纸卷 v1」（docs/design-spec.md）
   平铺分区 + 大数字考期 + 发丝线列表；零阴影、零渐变、唯一圆角 16rpx、8rpx 栅格。 */

page {
  background: var(--ink-50); /* 桌面色：衬托纸面边界 */
  color: var(--ink-900);
}

.page-wrap.index {
  padding: 24rpx 32rpx 64rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 模块卡：独立边界（明显边框 + 极轻阴影），桌面色衬底 */
.mod-card {
  background: var(--paper);
  border: 1rpx solid var(--ink-300);
  border-radius: var(--r-spec);
  padding: 32rpx 40rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(28, 28, 26, 0.05);
}

.col {
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.hairline {
  border-top: 1rpx solid var(--ink-200);
  margin: 24rpx 0;
}

/* ---------- AIGC 说明条（ink-50 底） ---------- */
.aigc-bar {
  display: flex;
  align-items: center;
  background: var(--ink-50);
  border: 1rpx solid var(--ink-200);
  border-radius: var(--r-spec);
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.aigc-body {
  flex: 1;
  min-width: 0;
}
.aigc-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink-900);
}
.aigc-desc {
  font-size: 22rpx;
  color: var(--ink-500);
}
.aigc-btn {
  flex-shrink: 0;
  color: var(--primary);
  font-size: 22rpx;
  padding: 12rpx 24rpx;
  border: 1rpx solid var(--primary);
  border-radius: var(--r-spec);
}

/* ---------- 考期区（无边框，大数字立于桌面，居中） ---------- */
.exam-zone {
  padding: 8rpx 0 24rpx;
  margin-bottom: 40rpx;
  text-align: center;
}
.exam-label {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--ink-700);
}
.exam-num-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin-top: 8rpx;
}
.exam-num {
  font-size: 140rpx;
  font-weight: 700;
  color: var(--primary);
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}
.exam-unit {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ink-900);
  margin-left: 12rpx;
}
.exam-date {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--ink-500);
}
.exam-empty-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--primary);
}
/* 卡内底部：连胜行（发丝线上方分隔，随考期居中） */
.exam-streak {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--ink-300);
}

/* ---------- 行（连胜 / 任务 / 继续）：在 mod-card 内使用，左右边距由卡片提供 ---------- */
.inline-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.inline-main {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink-900);
}
.inline-sub {
  font-size: 22rpx;
  color: var(--ink-500);
  margin-top: 4rpx;
}
.inline-action {
  flex-shrink: 0;
  font-size: 26rpx;
  color: var(--primary);
}
.inline-tag {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--ink-500);
  border: 1rpx solid var(--ink-200);
  border-radius: var(--r-spec);
  padding: 6rpx 16rpx;
}
.inline-tag.tag-ok {
  color: var(--primary);
  border-color: var(--primary);
}

/* ---------- 今日进度卡（左右边距由 mod-card 提供，避免覆盖导致文字贴边） ---------- */
.stat-zone {
  padding: 0;
}
.zone-label,
.quota-remain {
  font-size: 26rpx;
  color: var(--ink-500);
}
.stat-num-row {
  display: flex;
  align-items: baseline;
  margin-top: 8rpx;
}
.stat-num {
  font-size: 64rpx;
  font-weight: 700;
  color: var(--primary); /* 大号数字用墨蓝：适度增加主色占比 */
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
}
.stat-total {
  font-size: 26rpx;
  color: var(--ink-500);
  margin-left: 12rpx;
}
.progress-track {
  height: 8rpx;
  background: var(--ink-200);
  border-radius: 4rpx;
  overflow: hidden;
  margin: 20rpx 0 12rpx;
}
.progress-fill {
  height: 100%;
  background: var(--primary);
  border-radius: 4rpx;
  transition: width 0.4s var(--ease-spec);
}
.stat-reset {
  display: block;
  font-size: 22rpx;
  color: var(--ink-400);
}

/* ---------- 功能入口卡（行列表，左对齐统一基线） ---------- */
.entry-card {
  padding: 16rpx 40rpx;
}
.entry-row {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--ink-200);
}
.entry-row:last-of-type {
  border-bottom: none;
}
.entry-img {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  margin-right: 24rpx;
}
.entry-body {
  flex: 1;
  min-width: 0;
}
.entry-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink-900);
}
.entry-desc {
  display: block;
  font-size: 22rpx;
  color: var(--ink-500);
  margin-top: 4rpx;
}
