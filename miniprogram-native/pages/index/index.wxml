<view class="page-wrap index">
  <!-- AIGC 首次说明：仅展示一次（R2 / B-02） -->
  <view wx:if="{{showNotice}}" class="aigc-bar">
    <view class="aigc-body">
      <text class="aigc-title">题目由 AI 生成，仅供参考</text>
      <text class="aigc-desc">答案与解析请以官方教材为准</text>
    </view>
    <view class="aigc-btn" hover-class="press" hover-stay-time="80" bindtap="onAck">我已知晓</view>
  </view>

  <!-- 考期区（无边框，大数字直接立于桌面；picker 直接改日期） -->
  <picker mode="date" bindchange="onPickExamDate">
    <view class="exam-zone" hover-class="press" hover-stay-time="80">
      <block wx:if="{{examDate}}">
        <text class="exam-label">距离考期</text>
        <view class="exam-num-row">
          <text class="exam-num">{{countdown}}</text>
          <text class="exam-unit">天</text>
        </view>
        <text class="exam-date">{{examDate}} · 点击修改</text>
      </block>
      <block wx:else>
        <text class="exam-label">未设置考期</text>
        <text class="exam-empty-sub">点击选择日期，开启倒计时</text>
      </block>
      <view wx:if="{{streak}}" class="exam-streak">
        <text class="inline-main">{{streak.current > 0 ? "连续学习 " + streak.current + " 天" : "今天学习，点亮连胜"}}</text>
        <text
          wx:if="{{streak.can_makeup}}"
          class="inline-action"
          hover-class="press"
          hover-stay-time="80"
          catchtap="onMakeup"
        >补签 {{streak.makeup_date}}</text>
      </view>
    </view>
  </picker>

  <!-- 今日进度卡 -->
  <view class="mod-card stat-zone">
    <view class="row-between">
      <text class="zone-label">今日已刷</text>
      <text class="quota-remain">剩余 {{quota.remaining}} 题</text>
    </view>
    <view class="stat-num-row">
      <text class="stat-num">{{quota.used_today}}</text>
      <text class="stat-total">/ {{quota.free_daily_limit}} 题</text>
    </view>
    <view class="progress-track">
      <view class="progress-fill" style="width: {{progressPct}}%" />
    </view>
    <text class="stat-reset">{{quota.reset_rule || "额度每日 0 点重置"}}</text>
  </view>

  <!-- 今日任务卡 -->
  <view wx:if="{{dailyTask}}" class="mod-card inline-row" hover-class="press" hover-stay-time="80" bindtap="goMistakes">
    <view class="col">
      <text class="inline-main">今日任务 · 错题重练</text>
      <text class="inline-sub">{{dailyTask.completed ? "已完成，保持节奏" : "练错题即计入任务进度"}}</text>
    </view>
    <text wx:if="{{dailyTask.completed}}" class="inline-tag tag-ok">已完成</text>
    <text wx:else class="inline-tag">{{taskRemain}}</text>
  </view>

  <!-- 继续上次闯关卡 -->
  <view wx:if="{{resume}}" class="mod-card inline-row" hover-class="press" hover-stay-time="80" bindtap="goResume">
    <view class="col">
      <text class="inline-main">继续上次闯关</text>
      <text class="inline-sub">已答 {{resume.answered}} / {{resume.total}} 题</text>
    </view>
    <text class="inline-action">继续</text>
  </view>

  <!-- 功能入口卡（发丝线行列表） -->
  <view class="mod-card entry-card">
    <view
      wx:for="{{entries}}"
      wx:key="title"
      class="entry-row"
      hover-class="press"
      hover-stay-time="80"
      data-url="{{item.url}}"
      bindtap="onEntryTap"
    >
      <image class="entry-img" src="{{item.icon}}" mode="aspectFit" />
      <view class="entry-body">
        <text class="entry-title">{{item.title}}</text>
        <text class="entry-desc">{{item.desc}}</text>
      </view>
    </view>
  </view>
</view>
