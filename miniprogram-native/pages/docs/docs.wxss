
page {
  background: var(--ink-50);
  --brand: #2f5a8f;
  --brand-dark: #2f5a8f;
  --brand-light: #f3efe7;
  --success: #2f5a8f;
  --success-light: #f3efe7;
  --danger: #c25450;
  --danger-light: #f3efe7;
  --warn: #c25450;
  --warn-light: #f3efe7;
  --text-1: #1c1c1a;
  --text-2: #55524a;
  --text-3: #8a8577;
  --border: #e8e2d8;
  --bg: #f3efe7;
  --card: #faf7f2;
  --shadow-card: none;
}

/* 「自建题库 · 组卷出题」是次要入口：资料卡片上的「出题」才是主路径，
   此处显式弱化，避免与资料列表争夺注意力（#26 第三批） */
.kb-entry {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--t-dim, #8a8f99);
  text-align: center;
  padding: 16rpx 0;
  background: transparent;
  border: 1rpx dashed var(--ink-300);
}

.progress-track {
  height: 12rpx;
  background: var(--bg);
  border-radius: var(--r-pill);
  overflow: hidden;
  margin: 16rpx 0 8rpx;
}
.progress-fill {
  height: 100%;
  background: var(--primary);
  border-radius: var(--r-pill);
  transition: width 0.2s;
}

.upload-card {
  border: 2rpx solid var(--brand-light);
}
.upload-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.empty-hint {
  padding: 60rpx 32rpx;
}
.empty-hint .btn-primary {
  margin-top: 32rpx;
}
.tip {
  display: block;
  margin-top: 16rpx;
  line-height: 1.6;
}

.doc-name {
  flex: 1;
  min-width: 0;
  font-size: var(--fs);
  font-weight: 600;
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.doc-meta {
  display: block;
  margin-top: 8rpx;
}
.doc-actions {
  gap: 20rpx;
  margin-top: 20rpx;
}
.act {
  flex: 1;
  height: 72rpx;
  line-height: 68rpx;
  font-size: var(--fs-sm);
}
.btn-danger {
  background: transparent;
  color: var(--danger-ink);
  border: 1rpx solid var(--danger-ink);
  border-radius: var(--r-spec);
  text-align: center;
}

.build-tip {
  display: block;
  text-align: center;
  padding: 24rpx 0 8rpx;
}
