/* 闯关发起页 ·「纸卷 v1」：模块行列表 + 模考卡；公共类 card-mod/zone-label/btn-main 来自 app.wxss。 */

page {
  background: var(--ink-50);
  color: var(--ink-900);
}

.page-wrap.quest {
  padding: 24rpx 32rpx 64rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.col {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

/* ---------- 模块行列表 ---------- */
.mod-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--ink-200);
}
.mod-row:last-of-type {
  border-bottom: none;
}
.mod-badge {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--ink-50);
  border-radius: var(--r-spec);
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink-700);
  margin-right: 24rpx;
  flex-shrink: 0;
}
.mod-body {
  flex: 1;
  min-width: 0;
}
.mod-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink-900);
}
.mod-desc {
  display: block;
  font-size: 22rpx;
  color: var(--ink-500);
  margin-top: 4rpx;
}

/* ---------- 已创建局行 ---------- */
.inline-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.inline-main {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink-900);
}
.inline-sub {
  display: block;
  font-size: 22rpx;
  color: var(--ink-500);
  margin-top: 4rpx;
}
.inline-action {
  flex-shrink: 0;
  font-size: 26rpx;
  color: var(--primary);
}

/* ---------- 模考卡 ---------- */
.mock-desc {
  display: block;
  font-size: 26rpx;
  color: var(--ink-700);
  line-height: 1.7;
  margin-bottom: 24rpx;
}
