<view class="page-wrap">
  <view wx:if="{{!loading && items.length === 0}}" class="empty-hint">
    <text>还没有完成的闯关局</text>
  </view>

  <block wx:else>
    <text class="section-title">历史闯关局</text>
    <view
      wx:for="{{items}}"
      wx:key="session_id"
      class="card hist-card"
      hover-class="press"
      hover-stay-time="80"
      data-sid="{{item.session_id}}"
      bindtap="onOpen"
    >
      <view class="row-between">
        <text class="hist-title">#{{item.session_id}} {{item.module || "综合"}}</text>
        <text class="hist-rate {{item.rateClass}}">{{item.rateText}}</text>
      </view>
      <text wx:if="{{item.knowledge_point}}" class="t-muted hist-kp">考点《{{item.knowledge_point}}》</text>
      <text class="t-dim hist-time">{{item.time}}</text>
      <view wx:if="{{item.knowledge_point}}" class="row-between repractice-row">
        <text class="t-dim">可重练本局考点</text>
        <!-- catchtap 阻止冒泡，避免同时触发"回看复盘" -->
        <view
          class="retry-btn"
          data-kp="{{item.knowledge_point}}"
          data-count="{{item.question_count}}"
          catchtap="onRepractice"
        >重练考点</view>
      </view>
    </view>
  </block>
</view>
