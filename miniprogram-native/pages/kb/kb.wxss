.page {
  padding: 24rpx 24rpx 0;
  background: #f6f7fb;
  min-height: 100vh;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 18rpx;
}

.input,
.textarea {
  width: 100%;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.textarea {
  min-height: 120rpx;
}

.hint {
  font-size: 24rpx;
  color: #999;
  margin-top: 14rpx;
}

.link {
  font-size: 26rpx;
  color: #3b7cff;
  margin-top: 14rpx;
}

.spec-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.spec-row:last-of-type {
  border-bottom: none;
}

.spec-name {
  font-size: 28rpx;
  color: #333;
}

.counter {
  display: flex;
  align-items: center;
}

.mini {
  width: 60rpx !important;
  min-height: 56rpx;
  line-height: 56rpx;
  padding: 0;
  margin: 0 12rpx;
  font-size: 32rpx;
}

.spec-count {
  font-size: 30rpx;
  width: 60rpx;
  text-align: center;
  color: #333;
}

.seg {
  display: flex;
  gap: 16rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  background: #f7f8fa;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #666;
}

.seg-item.on {
  background: #3b7cff;
  color: #fff;
}

.btn-primary {
  margin: 8rpx 0 24rpx;
  background: #3b7cff;
  color: #fff;
  border-radius: 16rpx;
  font-size: 32rpx;
}

.status-line {
  font-size: 28rpx;
  color: #555;
  padding: 6rpx 0;
}

.err {
  color: #e0483c;
  font-size: 26rpx;
  margin-top: 10rpx;
}

.q {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.q:last-child {
  border-bottom: none;
}

.q-stem {
  font-size: 28rpx;
  color: #222;
  margin-bottom: 12rpx;
  line-height: 1.6;
}

.q-opt {
  font-size: 26rpx;
  color: #555;
  padding: 4rpx 0 4rpx 20rpx;
}

.q-ans {
  font-size: 26rpx;
  color: #2a9d5c;
  margin-top: 10rpx;
}

.q-exp {
  font-size: 24rpx;
  color: #888;
  margin-top: 8rpx;
  line-height: 1.6;
}

.q-src {
  font-size: 22rpx;
  color: #aaa;
  margin-top: 8rpx;
}

.tail {
  height: 40rpx;
}
