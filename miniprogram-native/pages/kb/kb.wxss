.page {
  padding: 24rpx 24rpx 0;
  background: #f6f7fb;
  min-height: 100vh;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 18rpx;
}

.input,
.textarea {
  width: 100%;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.textarea {
  min-height: 120rpx;
}

/* input 必须显式给高度：小程序 input 默认高度偏小，配合 padding 后文字只露出下半截（#26 第三批）。
   内容区高度 = 88 - 上下 padding 40 = 48rpx，与 line-height 对齐，保证单行文字完整居中显示。 */
.input {
  height: 88rpx;
  line-height: 48rpx;
  padding-top: 20rpx;
  padding-bottom: 20rpx;
}

.hint {
  font-size: 24rpx;
  color: #999;
  margin-top: 14rpx;
}

.link {
  font-size: 26rpx;
  color: #3b7cff;
  margin-top: 14rpx;
}

.spec-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.spec-row:last-of-type {
  border-bottom: none;
}

.spec-name {
  font-size: 28rpx;
  color: #333;
}

.counter {
  display: flex;
  align-items: center;
}

.mini {
  width: 60rpx !important;
  min-height: 56rpx;
  line-height: 56rpx;
  padding: 0;
  margin: 0 12rpx;
  font-size: 32rpx;
}

.spec-count {
  font-size: 30rpx;
  width: 60rpx;
  text-align: center;
  color: #333;
}

.seg {
  display: flex;
  gap: 16rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  background: #f7f8fa;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #666;
}

.seg-item.on {
  background: #3b7cff;
  color: #fff;
}

.btn-primary {
  margin: 8rpx 0 24rpx;
  background: #3b7cff;
  color: #fff;
  border-radius: 16rpx;
  font-size: 32rpx;
}

.status-line {
  font-size: 28rpx;
  color: #555;
  padding: 6rpx 0;
}

.err {
  color: #e0483c;
  font-size: 26rpx;
  margin-top: 10rpx;
}

.q {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.q:last-child {
  border-bottom: none;
}

.q-stem {
  font-size: 28rpx;
  color: #222;
  margin-bottom: 12rpx;
  line-height: 1.6;
}

.q-opt {
  font-size: 26rpx;
  color: #555;
  padding: 4rpx 0 4rpx 20rpx;
}

.q-ans {
  font-size: 26rpx;
  color: #2a9d5c;
  margin-top: 10rpx;
}

.q-exp {
  font-size: 24rpx;
  color: #888;
  margin-top: 8rpx;
  line-height: 1.6;
}

.q-src {
  font-size: 22rpx;
  color: #aaa;
  margin-top: 8rpx;
}

/* ---------- #25 生题过程区（WorkBuddy 式） ---------- */

.run-head {
  padding: 8rpx 8rpx 20rpx;
}

.run-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #222;
  line-height: 1.5;
}

.run-sub {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.timeline {
  max-height: 46vh;
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.tl-item {
  display: flex;
  align-items: flex-start;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.tl-item:last-of-type {
  border-bottom: none;
}

/* 最新一条呼吸动画：让用户明确「还在跑」 */
.tl-typing {
  animation: breathe 1.4s ease-in-out infinite;
}

.tl-icon {
  font-size: 28rpx;
  width: 44rpx;
  flex-shrink: 0;
}

.tl-body {
  flex: 1;
}

.tl-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.tl-cursor {
  color: #3b7cff;
}

/* 思考句（模型的构思内容）：弱化 + 斜体，与「动作」区分（#26 增强） */
.tl-think .tl-text {
  color: #8a8f99;
  font-style: italic;
}

.tl-caret {
  font-size: 22rpx;
  color: #3b7cff;
  margin-left: 12rpx;
}

.tl-detail {
  margin-top: 10rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 16rpx;
}

.tl-slice {
  display: flex;
  flex-direction: column;
  margin-bottom: 12rpx;
}

.tl-slice-h {
  font-size: 24rpx;
  color: #333;
  margin-bottom: 6rpx;
}

.tl-slice-p {
  font-size: 22rpx;
  color: #888;
  line-height: 1.6;
}

.tl-detail-raw {
  font-size: 22rpx;
  color: #888;
  word-break: break-all;
}

.tl-anchor {
  height: 2rpx;
}

/* 题卡渐现 */
.q-fade {
  animation: fadein 0.45s ease;
}

.run-footer {
  padding: 8rpx 8rpx 24rpx;
}

.run-status {
  font-size: 26rpx;
  color: #666;
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.run-status-tag {
  color: #999;
}

.dot-pulse {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #3b7cff;
  margin-right: 12rpx;
  animation: breathe 1.2s ease-in-out infinite;
}

.btn-stop {
  background: #fff;
  color: #e0483c;
  border: 1rpx solid #f0c5c0;
  border-radius: 16rpx;
  font-size: 30rpx;
  margin-bottom: 16rpx;
}

.btn-retry {
  margin-top: 20rpx;
  background: #fff;
  color: #3b7cff;
  border: 1rpx solid #c7d9ff;
  border-radius: 16rpx;
  font-size: 30rpx;
}

.run-back {
  font-size: 26rpx;
  color: #3b7cff;
  text-align: center;
  padding: 10rpx 0;
}

@keyframes breathe {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.45;
  }
}

@keyframes fadein {
  from {
    opacity: 0;
    transform: translateY(8rpx);
  }
  to {
    opacity: 1;
    transform: none;
  }
}

.tail {
  height: 40rpx;
}
