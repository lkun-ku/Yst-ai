
page {
  background: var(--ink-50);
  --brand: #2f5a8f;
  --brand-dark: #2f5a8f;
  --brand-light: #f3efe7;
  --success: #2f5a8f;
  --success-light: #f3efe7;
  --danger: #c25450;
  --danger-light: #f3efe7;
  --warn: #c25450;
  --warn-light: #f3efe7;
  --text-1: #1c1c1a;
  --text-2: #55524a;
  --text-3: #8a8577;
  --border: #e8e2d8;
  --bg: #f3efe7;
  --card: #faf7f2;
  --shadow-card: none;
}

.set-title {
  font-size: var(--fs);
  font-weight: 600;
  color: var(--text-1);
}
.set-desc {
  font-size: var(--fs-xs);
  color: var(--text-3);
  margin-top: 4rpx;
}
.danger {
  border: 2rpx solid var(--danger-light);
}
.danger-text {
  color: var(--danger);
}
.arrow {
  font-size: 40rpx;
  color: var(--text-3);
  line-height: 1;
}
.warn-tip {
  display: block;
  text-align: center;
  padding: 16rpx;
}

.data-summary {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 8rpx 4rpx;
}
.data-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.data-k {
  font-size: var(--fs-sm);
  color: var(--text-2);
}
.data-v {
  font-size: var(--fs);
  font-weight: 600;
  color: var(--brand-dark);
}
.data-block {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 8rpx;
  padding-top: 16rpx;
  border-top: 2rpx dashed var(--border);
}
.data-mastery {
  font-size: var(--fs-sm);
  color: var(--text-1);
  line-height: 1.7;
}
.data-muted {
  font-size: var(--fs-sm);
  color: var(--text-3);
}
