<view class="page-wrap">
  <text class="section-title">数据与隐私</text>

  <view class="card setting-card" hover-class="press" hover-stay-time="80" bindtap="onView">
    <view class="row-between">
      <view class="col">
        <text class="set-title">查看我的学习数据</text>
        <text class="set-desc">错题、每日任务、掌握度</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="card setting-card danger" hover-class="press" hover-stay-time="80" bindtap="onDelete">
    <view class="row-between">
      <view class="col">
        <text class="set-title danger-text">删除我的学习数据</text>
        <text class="set-desc">彻底清除本机账号的全部学习记录</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>

  <text class="t-dim warn-tip">删除后不可恢复（用户故事 #6）</text>

  <!-- 自写 modal 组件替代 nut-dialog（决策一：零 npm 依赖） -->
  <x-modal visible="{{showData}}" title="我的学习数据" bind:close="onCloseData">
    <view class="data-summary">
      <view class="data-row">
        <text class="data-k">已完成闯关</text>
        <text class="data-v">{{summary.sessionCount}} 局</text>
      </view>
      <view class="data-row">
        <text class="data-k">错题考点</text>
        <text class="data-v">{{summary.mistakeGroups}} 个</text>
      </view>
      <view class="data-block">
        <text class="data-k">最近一局掌握度</text>
        <text wx:if="{{summary.hasMastery}}" class="data-mastery">{{summary.masteryText}}</text>
        <text wx:else class="data-muted">暂无数据</text>
      </view>
    </view>
  </x-modal>
</view>
