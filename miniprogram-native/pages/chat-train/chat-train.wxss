/* #31 AI 模拟答：低饱和、对话优先、单一品牌蓝、统一 16rpx 圆角、无渐变 */
.page {
  /* #32 修复无法触底：父级必须用确定高度（min-height 会让 flex:1 子项按内容撑开，
     scroll-view 不产生内部滚动，底部内容被 fixed 输入栏遮住） */
  height: 100vh;
  background: #fafaf9;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ---- 配置态 ---- */
.config-hero {
  padding: 56rpx 40rpx 24rpx;
  display: flex;
  flex-direction: column;
}
.config-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1c1c1a;
}
.config-sub {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.6;
}
.sec-label {
  display: block;
  margin: 36rpx 40rpx 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #1c1c1a;
}
.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 0 40rpx;
}
.chip {
  padding: 14rpx 28rpx;
  border: 1rpx solid #d9dde3;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #374151;
  background: #fff;
}
.chip-on {
  background: #3b7cff;
  border-color: #3b7cff;
  color: #fff;
  font-weight: 600;
}
.seg-row {
  display: flex;
  gap: 16rpx;
  padding: 0 40rpx;
}
.seg {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border: 1rpx solid #d9dde3;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #374151;
  background: #fff;
}
.seg-on {
  background: #eef3ff;
  border-color: #3b7cff;
  color: #3b7cff;
  font-weight: 600;
}
.start-btn {
  margin: 56rpx 40rpx;
  padding: 26rpx 0;
  text-align: center;
  background: #3b7cff;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 16rpx;
}

/* #32 多会话：历史对话列表 */
.hist-list {
  margin: 0 40rpx;
  border: 1rpx solid #e4e7ec;
  border-radius: 16rpx;
  background: #fff;
  overflow: hidden;
}
.hist-row {
  display: flex;
  align-items: center;
  padding: 22rpx 24rpx;
  border-bottom: 1rpx solid #f0f2f5;
}
.hist-row:last-child {
  border-bottom: none;
}
.hist-main {
  flex: 1;
  min-width: 0;
}
.hist-title {
  display: block;
  font-size: 28rpx;
  color: #1c1c1a;
  font-weight: 500;
}
.hist-cap {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #6b7280;
}
.hist-del {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #9aa4b2;
  padding: 6rpx 16rpx;
  border: 1rpx solid #e4e7ec;
  border-radius: 999rpx;
  margin-left: 16rpx;
}
.hist-arrow {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #3b7cff;
  margin-left: 16rpx;
}

/* ---- 聊天态 ---- */
.chat-top {
  padding: 16rpx 40rpx 12rpx;
  background: #fafaf9;
}
.top-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.nav-right {
  display: flex;
  gap: 24rpx;
}
.nav-btn {
  font-size: 24rpx;
  color: #6b7280;
}
.nav-btn-main {
  color: #3b7cff;
  font-weight: 600;
}
.top-label {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9aa4b2;
}
.bar {
  height: 6rpx;
  background: #e8eaee;
  border-radius: 3rpx;
  overflow: hidden;
}
.bar-in {
  height: 100%;
  background: #3b7cff;
  border-radius: 3rpx;
  transition: width 0.3s ease;
}
.top-label {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #6b7280;
}
.chat-scroll {
  flex: 1;
  min-height: 0; /* 关键：允许 flex 子项收缩，否则不产生内部滚动 */
  padding: 0 32rpx calc(180rpx + env(safe-area-inset-bottom)); /* 底部留白避开 fixed 输入栏 */
  box-sizing: border-box;
}
.scroll-pad {
  height: 40rpx;
}

.row-ai {
  display: flex;
  align-items: flex-start;
  margin: 24rpx 0;
}
.avatar {
  flex-shrink: 0;
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  border-radius: 50%;
  background: #1c1c1a;
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
  margin-right: 16rpx;
}
.bubble-ai {
  max-width: 78%;
  background: #f1f3f5;
  border-radius: 16rpx;
  border-top-left-radius: 4rpx;
  padding: 20rpx 24rpx;
}
.ai-text {
  font-size: 28rpx;
  color: #1c1c1a;
  line-height: 1.65;
}
.caret {
  color: #3b7cff;
  font-size: 26rpx;
}
.chip-tag {
  display: inline-block;
  font-size: 20rpx;
  color: #3b7cff;
  border: 1rpx solid #3b7cff;
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
  margin-bottom: 10rpx;
}
.tag-warn {
  color: #c2660a;
  border-color: #c2660a;
}

/* #34 用户头像：品牌蓝底，与用户气泡同色系；AI 头像是深色底，左右两侧各有标识 */
.avatar-user {
  background: #3b7cff;
  color: #fff;
  margin-right: 0;
  margin-left: 16rpx;
}
.row-user {
  display: flex;
  justify-content: flex-end;
  align-items: flex-start;
  margin: 24rpx 0;
}
.bubble-user {
  max-width: 78%;
  background: #3b7cff;
  border-radius: 16rpx;
  border-top-right-radius: 4rpx;
  padding: 20rpx 24rpx;
}
.user-text {
  font-size: 28rpx;
  color: #fff;
  line-height: 1.65;
}

/* 思考中三点呼吸 */
.thinking {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 26rpx 28rpx;
}
.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #9aa4b2;
  animation: breath 1.2s ease-in-out infinite;
}
.d2 { animation-delay: 0.2s; }
.d3 { animation-delay: 0.4s; }
@keyframes breath {
  0%, 100% { opacity: 0.3; transform: translateY(0); }
  50% { opacity: 1; transform: translateY(-6rpx); }
}

/* 终评卡 */
.feedback-card {
  max-width: 82%;
  background: #fff;
  border: 1rpx solid #e4e7ec;
  border-radius: 16rpx;
  border-top-left-radius: 4rpx;
  padding: 24rpx;
}
.fb-head {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}
.fb-label {
  font-size: 24rpx;
  color: #6b7280;
}
.fb-score {
  font-size: 44rpx;
  font-weight: 700;
  color: #1c1c1a;
}
.fb-bar {
  margin: 14rpx 0 18rpx;
  height: 8rpx;
  background: #e8eaee;
  border-radius: 4rpx;
  overflow: hidden;
}
.fb-bar-in {
  height: 100%;
  background: #3b7cff;
  border-radius: 4rpx;
}
.pt-row {
  display: flex;
  align-items: flex-start;
  margin: 8rpx 0;
}
.pt-dot {
  flex-shrink: 0;
  width: 34rpx;
  height: 34rpx;
  line-height: 34rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 20rpx;
  color: #fff;
  margin-right: 12rpx;
}
.pt-ok { background: #2e9e5b; }
.pt-miss { background: #c25450; }
.pt-wrong { background: #c2660a; }
.pt-list { flex: 1; }
.pt-item {
  display: block;
  font-size: 24rpx;
  line-height: 1.6;
  color: #374151;
}
.pt-miss-t { color: #6b7280; }
.pt-wrong-t { color: #c2660a; }
.fb-text {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #1c1c1a;
  line-height: 1.6;
}
.fb-sug {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #3b7cff;
  line-height: 1.6;
}

/* 汇总卡 */
.summary-card {
  margin: 32rpx 8rpx;
  background: #fff;
  border: 1rpx solid #e4e7ec;
  border-radius: 16rpx;
  padding: 32rpx;
}
.sum-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #1c1c1a;
  margin-bottom: 24rpx;
}
.sum-row {
  display: flex;
  text-align: center;
}
.sum-cell { flex: 1; }
.sum-num {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #3b7cff;
}
.sum-cap {
  font-size: 22rpx;
  color: #6b7280;
}
.sum-btns {
  margin-top: 28rpx;
  display: flex;
}
.sum-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.sum-btn.ghost {
  border: 1rpx solid #3b7cff;
  color: #3b7cff;
  background: #fff;
}

/* 输入栏（#32 修复：固定高度防 placeholder 裁半；min-width 防 input 挤压相邻按钮） */
.input-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #e8eaee;
  box-sizing: border-box;
}
.force-final {
  flex-shrink: 0;
  height: 64rpx;
  line-height: 62rpx;
  font-size: 22rpx;
  color: #6b7280;
  border: 1rpx solid #d9dde3;
  border-radius: 999rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  white-space: nowrap;
}
.chat-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  line-height: 72rpx;
  background: #f1f3f5;
  border-radius: 999rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}
.send-btn {
  flex-shrink: 0;
  height: 72rpx;
  line-height: 72rpx;
  background: #3b7cff;
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 0 30rpx;
  box-sizing: border-box;
  white-space: nowrap;
}
.send-dim { opacity: 0.5; }

/* #37 语音 */
.voice-btn {
  flex-shrink: 0;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 26rpx;
  color: #374151;
  background: #f1f3f5;
  border-radius: 999rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  white-space: nowrap;
}
.voice-rec {
  background: #fff1f0;
  color: #c25450;
  font-weight: 600;
}
.speak-btn {
  display: inline-block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #3b7cff;
  border: 1rpx solid #3b7cff;
  border-radius: 999rpx;
  padding: 4rpx 18rpx;
}
.speak-on {
  background: #eef3ff;
  font-weight: 600;
}

.press { opacity: 0.85; transform: scale(0.98); }
