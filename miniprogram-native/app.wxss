/* ============================================================
   设计系统 · 清新教育风（蓝绿主色 + 大圆角卡片 + 柔和阴影）
   原样平移自 miniprogram/src/app.less（无 Less 嵌套/混入，故可直接复制）。
   所有尺寸使用 rpx —— 微信原生 WXSS 原生支持 rpx，无需 Taro pxtransform。
   ============================================================ */

page {
  /* 品牌色 */
  --brand: #12b3a8;
  --brand-dark: #0e948b;
  --brand-light: #e6f7f6;
  --accent: #4a90e2;
  --accent-light: #eaf2fd;

  /* 语义色 */
  --success: #22c55e;
  --success-light: #e8f8ee;
  --warn: #ff9500;
  --warn-light: #fff4e5;
  --danger: #fa5757;
  --danger-light: #fff1f0;

  /* 中性 */
  --bg: #f4f7f9;
  --card: #ffffff;
  --text-1: #1b2a33;
  --text-2: #5a6c78;
  --text-3: #9aa9b4;
  --border: #e8eef2;

  /* 圆角 */
  --r-sm: 12rpx;
  --r-md: 20rpx;
  --r-lg: 28rpx;
  --r-pill: 999rpx;

  /* 间距 */
  --sp-xs: 12rpx;
  --sp-sm: 16rpx;
  --sp: 24rpx;
  --sp-lg: 32rpx;

  /* 阴影 */
  --shadow-card: 0 4rpx 16rpx rgba(27, 42, 51, 0.06);
  --shadow-brand: 0 8rpx 24rpx rgba(18, 179, 168, 0.22);

  /* 字号 */
  --fs-xs: 22rpx;
  --fs-sm: 26rpx;
  --fs: 28rpx;
  --fs-lg: 32rpx;
  --fs-xl: 40rpx;

  /* 「纸卷 v1」设计规范令牌（docs/design-spec.md）——改版页面专用，渐进替换旧令牌 */
  --paper: #faf7f2;        /* 页面底色（暖纸白） */
  --ink-50: #f3efe7;       /* 区块底 / 选中行底 / 骨架屏 */
  --ink-100: #ede8de;      /* 输入框底 */
  --ink-200: #e8e2d8;      /* 发丝线 / 进度轨道 */
  --ink-300: #d8d1c4;      /* 禁用边框 */
  --ink-400: #b8b0a2;      /* 占位 / 禁用文字 */
  --ink-500: #8a8577;      /* 次级文字 */
  --ink-700: #55524a;      /* 正文次级 */
  --ink-900: #1c1c1a;      /* 标题 / 题干 / 正文主色 */
  --primary: #2f5a8f;      /* 墨蓝：行动 / 正确 / 进度 */
  --danger-ink: #c25450;   /* 赤红：仅错误语义 */
  --r-spec: 16rpx;         /* 唯一圆角 */
  --ease-spec: cubic-bezier(0.32, 0.72, 0, 1);

  background: var(--bg);
  color: var(--text-1);
  font-size: var(--fs);
  line-height: 1.6;
  box-sizing: border-box;
}

view,
text,
input,
button {
  box-sizing: border-box;
}

/* ---------- 布局容器（响应式 + 安全区） ---------- */
.page-wrap {
  padding: var(--sp);
  padding-bottom: calc(var(--sp) + env(safe-area-inset-bottom));
  min-height: 100vh;
}

.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.col {
  display: flex;
  flex-direction: column;
}

/* ---------- 卡片 ---------- */
.card {
  background: var(--card);
  border-radius: var(--r-lg);
  padding: var(--sp);
  box-shadow: var(--shadow-card);
  margin-bottom: var(--sp);
}

.card-flat {
  background: var(--card);
  border-radius: var(--r-lg);
  padding: var(--sp);
  margin-bottom: var(--sp);
}

.card-title {
  font-size: var(--fs-lg);
  font-weight: 600;
  color: var(--text-1);
  margin-bottom: var(--sp-sm);
}

.card-sub {
  font-size: var(--fs-sm);
  color: var(--text-2);
}

/* ---------- 文本 ---------- */
.t-muted {
  color: var(--text-2);
  font-size: var(--fs-sm);
}

.t-dim {
  color: var(--text-3);
  font-size: var(--fs-xs);
}

.t-strong {
  font-weight: 600;
  color: var(--text-1);
}

/* ---------- 标签 ---------- */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: var(--r-pill);
  font-size: var(--fs-xs);
  line-height: 1.8;
}

.tag-brand {
  background: var(--brand-light);
  color: var(--brand-dark);
}

.tag-warn {
  background: var(--warn-light);
  color: var(--warn);
}

.tag-danger {
  background: var(--danger-light);
  color: var(--danger);
}

.tag-accent {
  background: var(--accent-light);
  color: var(--accent);
}

/* ---------- 按钮 ---------- */
.btn-primary {
  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-dark) 100%);
  color: #fff;
  border-radius: var(--r-pill);
  font-size: var(--fs);
  font-weight: 500;
  text-align: center;
  padding: 0;
  height: 88rpx;
  line-height: 88rpx;
  border: none;
  box-shadow: var(--shadow-brand);
}

.btn-primary::after {
  border: none;
}

.btn-primary--press {
  opacity: 0.85;
  transform: scale(0.98);
}

.btn-ghost {
  background: var(--card);
  color: var(--brand-dark);
  border: 2rpx solid var(--brand);
  border-radius: var(--r-pill);
  height: 88rpx;
  line-height: 84rpx;
  text-align: center;
  font-size: var(--fs);
}

/* R11：通用按压反馈类，供全站可点击卡片/按钮复用（hover-class 可靠触发） */
.press {
  opacity: 0.92;
  transform: scale(0.98);
}

/* ============================================================
   「纸卷 v1」公共组件（docs/design-spec.md）——改版页面共享
   ============================================================ */

/* 模块卡：paper 底 + 明显边框 + 极轻阴影（页面底色需为桌面色 --ink-50） */
.card-mod {
  background: var(--paper);
  border: 1rpx solid var(--ink-300);
  border-radius: var(--r-spec);
  padding: 32rpx 40rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(28, 28, 26, 0.05);
  box-sizing: border-box;
}

/* 分区小标 */
.zone-label {
  display: block;
  font-size: 26rpx;
  color: var(--ink-500);
  margin-bottom: 20rpx;
}

/* 主按钮：墨蓝平色 */
.btn-main {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: var(--primary);
  color: #ffffff;
  border-radius: var(--r-spec);
  font-size: 30rpx;
  font-weight: 600;
  transition: transform 0.15s var(--ease-spec);
}
/* 次按钮：墨蓝描边 */
.btn-sub {
  height: 88rpx;
  line-height: 84rpx;
  text-align: center;
  background: transparent;
  color: var(--primary);
  border: 1rpx solid var(--primary);
  border-radius: var(--r-spec);
  font-size: 30rpx;
  box-sizing: border-box;
  transition: transform 0.15s var(--ease-spec);
}
/* 幽灵行按钮：无框，文字 + 图标语义 */
.btn-ghost-ink {
  color: var(--primary);
  font-size: 26rpx;
  padding: 8rpx 12rpx;
}

/* 发丝线 */
.hairline-v1 {
  border-top: 1rpx solid var(--ink-300);
}

/* 空态说明 */
.empty-note {
  font-size: 26rpx;
  color: var(--ink-500);
}

.btn-ghost--press {
  opacity: 0.85;
  transform: scale(0.98);
}

/* ---------- 输入框 ---------- */
.field {
  flex: 1;
  background: #fff;
  border: 2rpx solid var(--border);
  border-radius: var(--r-md);
  padding: 20rpx 24rpx;
  font-size: var(--fs);
  color: var(--text-1);
  /* 原生 input 不指定 line-height 时 placeholder 按字体基线对齐，会偏上；
     显式 line-height 让占位文字垂直居中（影响 daily 考期/generate 知识点范围/answer 填空简答）。 */
  line-height: 1.5;
  min-height: 88rpx;
  box-sizing: border-box;
}

.field:focus {
  border-color: var(--brand);
}

/* ---------- 区块标题 ---------- */
.section-title {
  font-size: var(--fs-sm);
  color: var(--text-3);
  margin: var(--sp-sm) 0;
  padding-left: 4rpx;
}

/* ---------- 空状态 ---------- */
.empty-hint {
  text-align: center;
  color: var(--text-3);
  font-size: var(--fs-sm);
  padding: 80rpx 0;
}
