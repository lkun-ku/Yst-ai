# ==== 复制本文件为 backend/.env 并填入你自己的配置 ====

# 数据库（默认 SQLite；生产可切 PostgreSQL+pgvector）
DATABASE_URL=sqlite:///./dev.db
AUTO_MIGRATE=true

# LLM（OpenAI 兼容 Chat Completions 协议）
# fake=零额度全功能可用；real=接入真实模型
LLM_MODE=fake
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=你的LLM_API_KEY
LLM_MODEL=deepseek-flash

# 备用供应商（可选）：主模型不可用时自动切换
LLM_FALLBACK_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_FALLBACK_API_KEY=你的备用API_KEY
LLM_FALLBACK_MODEL=qwen-plus

# Embedding（dashscope，用于资料出题的向量检索；fake=假向量）
EMBEDDING_MODE=fake
EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=你的DASHSCOPE_API_KEY
EMBEDDING_MODEL=text-embedding-v3

# 内容安全（微信 msgSecCheck；缺 APPID/SECRET 自动降级为放行占位）
WX_APPID=
WX_SECRET=

# 管理后台令牌（审校队列/纠错处理）
ADMIN_TOKEN=change-me
